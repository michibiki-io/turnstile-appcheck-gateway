# Traefik published ports
TRAEFIK_PORT=8080
TRAEFIK_DASHBOARD_PORT=8088

# appcheck-service config
APPCHECK_SUBPATH=/appcheck
LOG_LEVEL=debug
REQUEST_TIMEOUT=10s
APPCHECK_TOKEN_TTL=30m

TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret
TURNSTILE_SITEVERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_APP_ID=1:1234567890:web:abcdef123456
# Optional: if set, this is used directly
# FIREBASE_APP_RESOURCE=projects/your-firebase-project-id/apps/1:1234567890:web:abcdef123456

# Use BASE64 for compose env files (recommended)
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=base64-encoded-service-account-json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional CORS origin allowlist for /exchange
# ALLOWED_EXCHANGE_ORIGINS=http://localhost:8080

TRUST_PROXY_HEADERS=true
VERIFY_HEADER_NAME=X-Firebase-AppCheck
VERIFY_SUCCESS_STATUS=204
VERIFY_FAILURE_STATUS=401
HEALTH_PATH=/healthz
READY_PATH=/readyz
