# Core server
APPCHECK_SUBPATH=/appcheck
LOG_LEVEL=info
REQUEST_TIMEOUT=10s
APPCHECK_TOKEN_TTL=30m

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=your-turnstile-secret
TURNSTILE_SITEVERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Firebase App Check
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_APP_ID=1:1234567890:web:abcdef123456
# Optional override. If set, this value is used directly.
# FIREBASE_APP_RESOURCE=projects/your-firebase-project-id/apps/1:1234567890:web:abcdef123456

# Google service account credentials (choose one; BASE64 takes precedence)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=base64-encoded-service-account-json

# Exchange endpoint restrictions (optional)
# ALLOWED_EXCHANGE_ORIGINS=https://example.com,https://www.example.com

# Proxy trust for remote IP forwarding to Turnstile (optional)
TRUST_PROXY_HEADERS=false

# Verify endpoint behavior (optional)
VERIFY_HEADER_NAME=X-Firebase-AppCheck
VERIFY_SUCCESS_STATUS=204
VERIFY_FAILURE_STATUS=401

# Health endpoints (optional)
HEALTH_PATH=/healthz
READY_PATH=/readyz
