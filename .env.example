# Core server
APPCHECK_SUBPATH=/appcheck
LOG_LEVEL=info
REQUEST_TIMEOUT=10s
APPCHECK_TOKEN_TTL=30m

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=your-turnstile-secret
TURNSTILE_SITEVERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Firebase App Check
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_APP_ID=1:1234567890:web:abcdef123456
# Optional override. If set, this value is used directly.
# FIREBASE_APP_RESOURCE=projects/your-firebase-project-id/apps/1:1234567890:web:abcdef123456

# Google service account credentials (choose one; BASE64 takes precedence)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=base64-encoded-service-account-json

# Exchange endpoint restrictions (optional)
# ALLOWED_EXCHANGE_ORIGINS=https://example.com,https://www.example.com

# Proxy trust for remote IP forwarding to Turnstile (optional)
TRUST_PROXY_HEADERS=false

# Verify endpoint behavior (optional)
VERIFY_HEADER_NAME=X-Firebase-AppCheck
VERIFY_SUCCESS_STATUS=204
VERIFY_FAILURE_STATUS=401

# Health endpoints (optional)
HEALTH_PATH=/healthz
READY_PATH=/readyz

# Admin dashboard and audit log
ADMIN_DASHBOARD_ENABLED=true
ADMIN_BASE_PATH=/admin
ADMIN_AUDIT_TIMESTAMP_FORMAT=2006-01-02 15:04:05 MST
ADMIN_AUDIT_TIMESTAMP_TIMEZONE=Asia/Tokyo
ADMIN_AUTH_MODE=header
ADMIN_AUTH_USER_HEADER=X-Forwarded-User
ADMIN_AUTH_EMAIL_HEADER=X-Forwarded-Email
ADMIN_AUTH_GROUPS_HEADER=X-Forwarded-Groups
ADMIN_ALLOWED_USERS=
ADMIN_ALLOWED_GROUPS=gateway-admins

# Use ADMIN_AUTH_MODE=none only when a trusted upstream layer protects /admin and /_admin.
# ADMIN_AUTH_MODE=none

AUDIT_ENABLED=true
AUDIT_SQLITE_PATH=/var/lib/turnstile-appcheck-gateway/audit.db
AUDIT_RETENTION_DAYS=90

# In-memory public endpoint rate limiting. Limits are per instance.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
